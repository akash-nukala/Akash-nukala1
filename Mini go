#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int guess, number, points = 100;

    srand(time(0));
    number = rand() % 10 + 1; // Random number between 1–10

    printf("Welcome to Mini Guess Game!\n");
    printf("You have 100 points.\n");
    printf("Guess a number between 1 and 10:\n");

    scanf("%d", &guess);

    if (guess == number) {
        printf("Correct! You win 50 points.\n");
        points += 50;
    } else {
        printf("Wrong! The number was %d\n", number);
        points -= 20;
    }

    printf("Your total points: %d\n", points);

    return 0;
}
